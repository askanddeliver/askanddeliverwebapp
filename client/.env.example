# --- Development ---
VITE_API_URL=http://localhost:3001/api
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=http://localhost:3001/api

# Dynamic intake form on /contact (Phase 3). Set to false to use legacy static form.
VITE_DYNAMIC_INTAKE=true
# Optional: public workspace key for local dev (sent as X-Public-Workspace header)
# VITE_DEV_PUBLIC_WORKSPACE=default

# --- Production (set these in Vercel dashboard → Settings → Environment Variables) ---
# VITE_API_URL=https://api.askanddeliver.com/api
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=your-production-client-id
# VITE_AUTH0_AUDIENCE=https://api.askanddeliver.com/api
